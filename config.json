{
  "data_dir": "data/faces",
  "artifacts_dir": "artifacts",
  "legacy_dir": "weights/legacy",
  "input_mode": "detect_faces",
  "splits": {"train": [1, 2, 3, 4], "val": [5], "test": [6]},
  "preprocess": {
    "size": [224, 224],
    "resize_mode": "pad",
    "normalization": "imagenet",
    "crop_face": false,
    "face_margin": 0.2,
    "no_face": "error"
  },
  "training": {
    "backbone": "resnet18",
    "pretrained": true,
    "embedding_dim": 128,
    "epochs": 40,
    "batch_size": 16,
    "lr": 0.0003,
    "weight_decay": 0.0001,
    "patience": 8,
    "seed": 42,
    "num_workers": 0,
    "device": "cuda"
  }
}
